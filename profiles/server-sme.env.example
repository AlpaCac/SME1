# 最终服务器 Profile 的格式示例。数值仅用于说明；实际文件由步骤 04 根据目标机
# server-model.env 和运行结果生成，不应直接复制本示例部署。
# 选择内建基础 Profile；generic-sme 表示使用通用 SME 分析规则并由后续字段覆盖硬件值。
export SME_PREFETCH_PROFILE=generic-sme
# 全局最低收益 score；候选 score 小于该值时以 Unprofitable 拒绝。
export SME_PREFETCH_MIN_PROFIT_SCORE=0
# 全局最低置信度百分比，范围 0-100；候选低于该值时以 LowConfidence 拒绝。
export SME_PREFETCH_MIN_CONFIDENCE=60
# 每个软件预取候选的基础发射成本，单位为模型 score 点。
export SME_PREFETCH_ISSUE_COST=2
# Cache 压力成本权重；实际成本按候选预取前沿占有效 cache 预算的百分比缩放。
export SME_PREFETCH_CACHE_PRESSURE_WEIGHT=32
# 带宽成本权重；实际成本按候选字节数占每迭代字节预算的百分比缩放。
export SME_PREFETCH_BANDWIDTH_WEIGHT=16
# 无法静态确定 trip count 时附加的成本 score。
export SME_PREFETCH_UNKNOWN_TRIP_PENALTY=48
# current-row L1 距离覆盖，单位为向量迭代；0 表示由延迟/有效周期模型自动计算。
export SME_PREFETCH_DISTANCE_CURRENT_L1=0
# row-neighbor L1 距离覆盖；0 表示自动计算。
export SME_PREFETCH_DISTANCE_ROW_L1=0
# plane-neighbor L1 near 距离覆盖；0 表示自动计算。
export SME_PREFETCH_DISTANCE_PLANE_L1=0
# plane-neighbor L2 warming 距离覆盖；0 表示自动计算。
export SME_PREFETCH_DISTANCE_PLANE_L2=0
# current-row L1 的 KEEP/STRM 覆盖；AUTO 表示由物理流复用模型决定。
export SME_PREFETCH_POLICY_CURRENT_L1=AUTO
# row-neighbor L1 的策略覆盖；可选 AUTO、KEEP、STRM。
export SME_PREFETCH_POLICY_ROW_L1=AUTO
# plane-neighbor L1 near 的策略覆盖；AUTO 下当前模型保守选择 STRM。
export SME_PREFETCH_POLICY_PLANE_L1=AUTO
# plane-neighbor L2 warming 的策略覆盖；AUTO 表示按复用证据决定。
export SME_PREFETCH_POLICY_PLANE_L2=AUTO
# Cache line 大小，单位 byte，通常来自 Linux sysfs。
export SME_PREFETCH_CACHE_LINE_BYTES=64
# SME streaming vector length，单位 byte，通常来自
# /proc/sys/abi/sme_default_vector_length。
export SME_PREFETCH_STREAMING_VL_BYTES=64
# L1 数据/统一 cache 标称容量，单位 byte。
export SME_PREFETCH_L1_CAPACITY_BYTES=65536
# L2 数据/统一 cache 标称容量，单位 byte。
export SME_PREFETCH_L2_CAPACITY_BYTES=1048576
# L1 可用于 stencil 与预取前沿的容量百分比，校准时通常保留一个 cache way。
export SME_PREFETCH_L1_CAPACITY_PERCENT=60
# L2 可使用容量百分比。
export SME_PREFETCH_L2_CAPACITY_PERCENT=60
# L1 依赖加载延迟，单位 CPU cycle，用于自动距离模型。
export SME_PREFETCH_L1_LATENCY_CYCLES=32
# L2 依赖加载延迟，单位 CPU cycle。
export SME_PREFETCH_L2_LATENCY_CYCLES=96
# 超过末级 cache 的内存访问延迟，单位 CPU cycle。
export SME_PREFETCH_MEMORY_LATENCY_CYCLES=240
# 代表性 2D stencil 每次最内层向量迭代的有效周期。
export SME_PREFETCH_USEFUL_CYCLES_2D=8
# 代表性 3D stencil 每次最内层向量迭代的有效周期。
export SME_PREFETCH_USEFUL_CYCLES_3D=10
# 未知 trip count 时允许的最大距离，单位为向量迭代次数。
export SME_PREFETCH_MAX_DISTANCE=32
# 可持续并发的最大独立预取物理流数。
export SME_PREFETCH_MAX_STREAMS=5
# 每次向量迭代允许的最大预取发射槽数量。
export SME_PREFETCH_MAX_INSTRUCTIONS=8
# 每次向量迭代允许请求的最大预取字节数，单位 byte。
export SME_PREFETCH_MAX_BYTES=512
