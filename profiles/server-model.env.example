# 目标服务器硬件模型模板。正常情况下不要手工填写，而是运行
# scripts/calibrate_server_model.sh 生成 profiles/server-model.env。
# Cache 容量、cache line 和 streaming VL 会自动探测，因此本模板只列出需要校准或
# 推导的字段；生成文件还会明确记录自动探测值。

# L1 可供 stencil 数据和预取前沿使用的容量百分比，范围 1-100。校准脚本按相联度
# 保留一个 cache way 后计算，不是 sysfs 直接提供的硬件属性。
export SME_PREFETCH_L1_CAPACITY_PERCENT=
# L2 可使用容量百分比，含义与 L1 相同。
export SME_PREFETCH_L2_CAPACITY_PERCENT=

# L1 依赖加载延迟，单位为 CPU cycle，用于计算 L1 预取距离。
export SME_PREFETCH_L1_LATENCY_CYCLES=
# L2 依赖加载延迟，单位为 CPU cycle，用于计算 L2 warming 距离。
export SME_PREFETCH_L2_LATENCY_CYCLES=
# 超过末级 cache 工作集的内存访问延迟，单位为 CPU cycle，用于推导最大距离和带宽
# 成本。三项延迟均由依赖加载微基准和 cycle PMU 测量。
export SME_PREFETCH_MEMORY_LATENCY_CYCLES=

# 代表性 2D stencil 每次最内层向量迭代的有效计算周期，用于把延迟换算成预取距离。
export SME_PREFETCH_USEFUL_CYCLES_2D=
# 代表性 3D stencil 每次最内层向量迭代的有效计算周期。
export SME_PREFETCH_USEFUL_CYCLES_3D=

# 未知 trip count 时允许的最大预取距离，单位为最内层向量迭代次数。
export SME_PREFETCH_MAX_DISTANCE=
# 目标机可持续并发的软件预取物理流数量，由 1-17 条独立随机流 PMU 扫描得到。
export SME_PREFETCH_MAX_STREAMS=
# 每次向量迭代允许占用的最大预取发射槽数量；由可持续流数和
# ceil(streaming_VL/cache_line) 推导。
export SME_PREFETCH_MAX_INSTRUCTIONS=
# 每次向量迭代允许请求的最大预取字节数，单位 byte。
export SME_PREFETCH_MAX_BYTES=

# 全局最低收益分数的初始值。0 表示先保留所有非负收益候选；步骤 04 会从 Pass 实际
# score 边界中实测选择最终值。
export SME_PREFETCH_MIN_PROFIT_SCORE=0
# 最低静态分析置信度，范围 0-100。当前 60 允许未知 trip count 的 L2 候选继续参与
# 实测，但仍会拒绝置信度更低的候选。
export SME_PREFETCH_MIN_CONFIDENCE=60
# 每个候选的基础 PRFM 发射成本，单位为模型 score 点，由有效计算周期除以可持续流数
# 推导。
export SME_PREFETCH_ISSUE_COST=
# Cache 压力权重：候选占满目标 cache 有效预算时对应的成本 score；实际成本按占用
# 百分比线性缩放。
export SME_PREFETCH_CACHE_PRESSURE_WEIGHT=
# 预取带宽权重：候选用满每迭代字节预算时对应的成本 score；实际成本按字节预算占比
# 线性缩放。
export SME_PREFETCH_BANDWIDTH_WEIGHT=
# 无法静态得到 trip count 时增加的成本 score，降低动态短循环被激进预取的概率。
export SME_PREFETCH_UNKNOWN_TRIP_PENALTY=
