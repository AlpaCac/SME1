# Copy to profiles/server-model.env on the target server after calibration.
# Cache capacities, cache line bytes, and streaming VL are normally detected.
# They may also be explicitly recorded here with SME_PREFETCH_* overrides.

# Cache occupancy limits are model safety constraints, not sysfs hardware facts.
export SME_PREFETCH_L1_CAPACITY_PERCENT=
export SME_PREFETCH_L2_CAPACITY_PERCENT=

# scripts/calibrate_server_model.sh measures these with dependent loads and PMU.
export SME_PREFETCH_L1_LATENCY_CYCLES=
export SME_PREFETCH_L2_LATENCY_CYCLES=
export SME_PREFETCH_MEMORY_LATENCY_CYCLES=

# The calibration script measures light 2D/3D stencil cycles per vector iteration.
export SME_PREFETCH_USEFUL_CYCLES_2D=
export SME_PREFETCH_USEFUL_CYCLES_3D=

# The calibration script derives admission limits from cache/VL and stream topology.
export SME_PREFETCH_MAX_DISTANCE=
export SME_PREFETCH_MAX_STREAMS=
export SME_PREFETCH_MAX_INSTRUCTIONS=
export SME_PREFETCH_MAX_BYTES=
